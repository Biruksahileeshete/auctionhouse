// AuctionHouse — Prisma Schema (MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  listings Listing[] @relation("SellerListings")
  bids     Bid[]

  @@map("users")
}

model Listing {
  id           String        @id @default(cuid())
  sellerId     String
  title        String
  description  String        @db.Text
  imageUrl     String?
  startingPrice Float
  minIncrement Float         @default(1.0)

  // currentPrice is a denormalized cache of the highest accepted bid,
  // updated inside the SAME transaction as the bid insert (never
  // separately) — so it can never drift out of sync with the real
  // highest Bid row. Reads can trust this field directly without
  // re-aggregating the Bid table every time.
  currentPrice Float?

  // endsAt is mutable — anti-sniping extends it. originalEndsAt is
  // immutable, kept purely for display/audit ("originally ended at X,
  // extended due to late bidding").
  endsAt        DateTime
  originalEndsAt DateTime

  status       ListingStatus @default(ACTIVE)
  winningBidId String?       @unique

  createdAt DateTime @default(now())

  seller      User  @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  bids        Bid[] @relation("ListingBids")
  winningBid  Bid?  @relation("WinningBid", fields: [winningBidId], references: [id])

  @@index([sellerId])
  @@index([status, endsAt])
  @@map("listings")
}

model Bid {
  id        String   @id @default(cuid())
  listingId String
  bidderId  String
  amount    Float
  createdAt DateTime @default(now())

  listing      Listing  @relation("ListingBids", fields: [listingId], references: [id], onDelete: Cascade)
  bidder       User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  winningFor   Listing? @relation("WinningBid")

  // Every bid ever placed is kept permanently — this table IS the audit
  // trail, not a separate log. Never deleted or overwritten.
  @@index([listingId, amount])
  @@index([bidderId])
  @@map("bids")
}
